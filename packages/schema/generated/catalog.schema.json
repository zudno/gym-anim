{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "characters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "poses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "machine",
              "bench",
              "rack",
              "free_weight"
            ]
          },
          "file": {
            "type": "string"
          },
          "parametric": {
            "default": false,
            "type": "boolean"
          },
          "anchors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
            }
          },
          "joints": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "revolute",
                    "prismatic",
                    "cable"
                  ]
                },
                "axis": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "drives": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
                  }
                }
              },
              "required": [
                "id",
                "type",
                "range"
              ],
              "additionalProperties": false
            }
          },
          "loadKinds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "barbell",
                "dumbbell",
                "stack"
              ]
            }
          },
          "defaultPose": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "thumbnail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "anchors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "characters",
    "poses",
    "equipment"
  ],
  "additionalProperties": false
}
